    <title>X Clone - Edit Profile</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { overflow-y: scroll; }
        .hover-bg:hover { background-color: rgba(0,0,0,0.05); cursor: pointer; transition: 0.2s; }
        .nav-link { color: #0f1419; font-size: 1.25rem; border-radius: 50px; padding: 12px 20px; transition: 0.2s; }
        .nav-link:hover { background-color: rgba(0,0,0,0.05); }
        .nav-link i { font-size: 1.6rem; margin-right: 15px; }
        .sticky-header { position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,0.85); backdrop-filter: blur(12px); }
        
        /* Edit Profile Specific Styles */
        .camera-overlay { 
            position: absolute; 
            top: 50%; left: 50%; 
            transform: translate(-50%, -50%); 
            background: rgba(0,0,0,0.5); 
            color: white; 
            padding: 12px; 
            border-radius: 50%; 
            cursor: pointer; 
            transition: 0.2s; 
        }
        .camera-overlay:hover { background: rgba(0,0,0,0.7); }
        .form-floating > .form-control:focus { border-color: #0f1419; box-shadow: none; border-width: 2px; }
    </style>
</head>
<body>
    <div class="container-fluid" style="max-width: 1280px;">
        <div class="row">
            
            <!-- Sidebar Left Partial Include -->
            <%- include('partials/sidebar', { activePage: 'profile' }) %>

            <!-- Main Content: Edit Profile -->
            <main class="col-10 col-md-9 col-xl-6 border-start border-end p-0 min-vh-100">
                <form action="/profile/edit" method="POST" enctype="multipart/form-data">
                    
                    <!-- Sticky Header -->
                    <div class="sticky-header p-2 d-flex align-items-center justify-content-between border-bottom">
                        <div class="d-flex align-items-center">
                            <a href="/profile" class="btn btn-light border-0 rounded-circle me-3 p-2 fs-5 hover-bg text-dark"><i class="bi bi-x-lg"></i></a>
                            <h4 class="fw-bold mb-0 lh-1">Edit profile</h4>
                        </div>
                        <button type="submit" class="btn btn-dark rounded-pill fw-bold px-4">Save</button>
                    </div>

                    <!-- Cover Image Upload -->
                    <div class="bg-secondary bg-opacity-25 position-relative" style="height: 200px; cursor: pointer;">
                        <!-- Overlay for Image Upload -->
                        <div class="d-flex position-absolute w-100 h-100 justify-content-center align-items-center bg-dark bg-opacity-25">
                            <label for="coverUpload" class="camera-overlay m-0 position-relative top-0 start-0 transform-none mx-2">
                                <i class="bi bi-camera fs-5"></i>
                            </label>
                            <div class="camera-overlay m-0 position-relative top-0 start-0 transform-none mx-2">
                                <i class="bi bi-x-lg fs-5"></i>
                            </div>
                        </div>
                        <input type="file" id="coverUpload" name="coverImage" class="d-none" accept="image/*">
                    </div>
                    
                    <!-- Avatar Upload -->
                    <div class="px-3 position-relative" style="margin-bottom: 60px;">
                        <div class="position-absolute" style="top: -70px; left: 16px;">
                            <img src="<%= typeof currentUser !== 'undefined' ? '/uploads/' + currentUser.profilePic : 'https://ui-avatars.com/api/?name=User&background=random' %>" class="rounded-circle border border-4 border-white bg-white" style="width: 140px; height: 140px; object-fit: cover;">
                            <label for="avatarUpload" class="camera-overlay m-0">
                                <i class="bi bi-camera fs-5"></i>
                            </label>
                            <input type="file" id="avatarUpload" name="profilePic" class="d-none" accept="image/*">
                        </div>
                    </div>

                    <!-- Form Inputs -->
                    <div class="px-3 pb-4">
                        <div class="form-floating mb-4">
                            <input type="text" class="form-control rounded-1 border" id="editName" name="fullName" placeholder="Name" value="<%= typeof currentUser !== 'undefined' ? currentUser.fullName : 'John Doe' %>" required>
                            <label for="editName" class="text-secondary">Name</label>
                        </div>
                        
                        <div class="form-floating mb-4">
                            <textarea class="form-control rounded-1 border pt-4" id="editBio" name="bio" placeholder="Bio" style="height: 120px"><%= typeof currentUser !== 'undefined' ? currentUser.bio : 'Full-stack developer building cool things on the internet. 💻 ☕' %></textarea>
                            <label for="editBio" class="text-secondary">Bio</label>
                        </div>

                        <!-- Location -->
                        <div class="form-floating mb-4">
                            <input type="text" class="form-control rounded-1 border" id="editLocation" name="location" placeholder="Location" value="<%= typeof currentUser !== 'undefined' ? currentUser.location : 'New York, USA' %>">
                            <label for="editLocation" class="text-secondary">Location</label>
                        </div>

                        <!-- SRS Mandatory Field: Time Zone -->
                        <div class="form-floating mb-4 border rounded-1">
                            <select class="form-select border-0" id="editTimezone" name="timezone" required>
                                <option value="" disabled>Select your time zone</option>
                                <option value="UTC" <%= typeof currentUser !== 'undefined' && currentUser.timezone === 'UTC' ? 'selected' : '' %>>UTC</option>
                                <option value="IST" <%= typeof currentUser !== 'undefined' && currentUser.timezone === 'IST' ? 'selected' : '' %>>India Standard Time (IST)</option>
                                <option value="EST" <%= typeof currentUser === 'undefined' || currentUser.timezone === 'EST' ? 'selected' : '' %>>Eastern Time (EST)</option>
                                <option value="PST" <%= typeof currentUser !== 'undefined' && currentUser.timezone === 'PST' ? 'selected' : '' %>>Pacific Time (PST)</option>
                            </select>
                            <label for="editTimezone" class="text-secondary">Time Zone (Mandatory)</label>
                        </div>
                    </div>
                </form>
            </main>

            <!-- Blank Right Sidebar Space -->
            <aside class="col-xl-4 d-none d-xl-block py-3 ps-4 pe-lg-5"></aside>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>




