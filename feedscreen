<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>X Clone - Home</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { overflow-y: scroll; }
        .hover-bg:hover { background-color: rgba(0,0,0,0.05); cursor: pointer; transition: 0.2s; }
        .nav-link { color: #0f1419; font-size: 1.25rem; border-radius: 50px; padding: 12px 20px; transition: 0.2s; }
        .nav-link:hover { background-color: rgba(0,0,0,0.05); }
        .nav-link i { font-size: 1.6rem; margin-right: 15px; }
        .tweet-border { border-bottom: 1px solid #eff3f4; }
        .sticky-header { position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid #eff3f4; }
    </style>
</head>
<body>
    <div class="container-fluid" style="max-width: 1280px;">
        <div class="row">
            
            <!-- Sidebar Left -->
            <div class="col-2 col-md-3 col-xl-2 d-flex flex-column sticky-top vh-100 py-2 ps-md-4 pe-2">
                <a href="home.html" class="d-inline-block p-2 mb-3 mt-1 text-dark">
                    <svg viewBox="0 0 24 24" aria-hidden="true" style="width: 30px; fill: #0f1419;"><g><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 22.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></g></svg>
                </a>
                <nav class="nav flex-column gap-1 mb-auto">
                    <a href="home.html" class="nav-link fw-bold d-flex align-items-center"><i class="bi bi-house-door-fill"></i> <span class="d-none d-md-inline">Home</span></a>
                    <a href="#" class="nav-link d-flex align-items-center"><i class="bi bi-search"></i> <span class="d-none d-md-inline">Explore</span></a>
                    <a href="profile.html" class="nav-link d-flex align-items-center"><i class="bi bi-person"></i> <span class="d-none d-md-inline">Profile</span></a>
                    <a href="otp.html" class="nav-link text-danger d-flex align-items-center"><i class="bi bi-shield-lock"></i> <span class="d-none d-md-inline">OTP Simulation</span></a>
                    <a href="login.html" class="nav-link d-flex align-items-center"><i class="bi bi-box-arrow-left"></i> <span class="d-none d-md-inline">Logout</span></a>
                </nav>
                <button class="btn btn-primary rounded-pill fw-bold py-3 mt-3 w-100 d-none d-md-block shadow-sm">Post</button>
                <button class="btn btn-primary rounded-circle mt-3 d-md-none p-3 shadow-sm mx-auto"><i class="bi bi-feather"></i></button>
                
                <div class="mt-4 p-2 hover-bg rounded-pill d-flex align-items-center mb-3">
                    <img src="https://ui-avatars.com/api/?name=John+Doe&background=random" class="rounded-circle me-md-2" width="40" height="40">
                    <div class="d-none d-md-block lh-sm overflow-hidden">
                        <div class="fw-bold text-truncate">John Doe</div>
                        <div class="text-secondary small text-truncate">@johndoe</div>
                    </div>
                    <i class="bi bi-three-dots ms-auto d-none d-md-block px-2"></i>
                </div>
            </div>

            <!-- Main Feed -->
            <main class="col-10 col-md-9 col-xl-6 border-start border-end p-0 min-vh-100">
                <div class="sticky-header pt-3">
                    <ul class="nav nav-underline flex-nowrap w-100 text-center">
                        <li class="nav-item flex-grow-1"><a class="nav-link active fw-bold text-dark pb-3 px-0 rounded-0" href="#">For you</a></li>
                        <li class="nav-item flex-grow-1"><a class="nav-link text-secondary pb-3 px-0 rounded-0" href="#">Following</a></li>
                    </ul>
                </div>

                <!-- Composer -->
                <div class="p-3 tweet-border d-flex">
                    <img src="https://ui-avatars.com/api/?name=John+Doe&background=random" class="rounded-circle me-3" width="40" height="40">
                    <div class="w-100">
                        <textarea class="form-control border-0 fs-5 px-0 shadow-none bg-transparent pt-2" rows="2" placeholder="What is happening?!"></textarea>
                        <div class="border-bottom my-2"></div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <div class="text-primary fs-5 d-flex gap-1">
                                <i class="bi bi-image hover-bg rounded-circle p-2"></i>
                                <i class="bi bi-filetype-gif hover-bg rounded-circle p-2"></i>
                                <i class="bi bi-emoji-smile hover-bg rounded-circle p-2"></i>
                                <i class="bi bi-geo-alt hover-bg rounded-circle p-2"></i>
                            </div>
                            <button class="btn btn-primary rounded-pill px-4 fw-bold">Post</button>
                        </div>
                    </div>
                </div>

                <!-- Tweet Card 1 -->
                <div class="p-3 tweet-border hover-bg d-flex">
                    <img src="https://ui-avatars.com/api/?name=Elon+Musk&background=0D8ABC&color=fff" class="rounded-circle me-3" width="40" height="40">
                    <div class="w-100">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold">Elon Musk</span>
                                <i class="bi bi-patch-check-fill text-primary"></i>
                                <span class="text-secondary small">@elonmusk · 2h</span>
                            </div>
                            <i class="bi bi-three-dots text-secondary p-2 hover-bg rounded-circle"></i>
                        </div>
                        <p class="mb-2">Rebuilding the UI with separate files using Bootstrap 5 makes the codebase much cleaner and easier to manage in Node.js! 🚀</p>
                        <div class="d-flex justify-content-between text-secondary mt-2 pe-md-5 small">
                            <div class="hover-bg p-2 rounded-pill text-primary"><i class="bi bi-chat me-2"></i>1.2K</div>
                            <div class="hover-bg p-2 rounded-pill text-success"><i class="bi bi-arrow-repeat me-2"></i>5K</div>
                            <div class="hover-bg p-2 rounded-pill text-danger"><i class="bi bi-heart me-2"></i>45K</div>
                            <div class="hover-bg p-2 rounded-pill text-primary"><i class="bi bi-bar-chart me-2"></i>1M</div>
                        </div>
                    </div>
                </div>

                <!-- Tweet Card 2 (With Image) -->
                <div class="p-3 tweet-border hover-bg d-flex">
                    <img src="https://ui-avatars.com/api/?name=Tech+News&background=f00&color=fff" class="rounded-circle me-3" width="40" height="40">
                    <div class="w-100">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold">Tech News</span>
                                <span class="text-secondary small">@technews · 5h</span>
                            </div>
                            <i class="bi bi-three-dots text-secondary p-2 hover-bg rounded-circle"></i>
                        </div>
                        <p class="mb-2">Checkout the new layouts.</p>
                        <div class="bg-light border rounded-4 d-flex justify-content-center align-items-center overflow-hidden mb-2" style="height: 280px; background-color: #e1e8ed;">
                            <i class="bi bi-image text-secondary opacity-50" style="font-size: 4rem;"></i>
                        </div>
                        <div class="d-flex justify-content-between text-secondary mt-2 pe-md-5 small">
                            <div class="hover-bg p-2 rounded-pill text-primary"><i class="bi bi-chat me-2"></i>120</div>
                            <div class="hover-bg p-2 rounded-pill text-success"><i class="bi bi-arrow-repeat me-2"></i>45</div>
                            <div class="hover-bg p-2 rounded-pill text-danger"><i class="bi bi-heart me-2"></i>890</div>
                            <div class="hover-bg p-2 rounded-pill text-primary"><i class="bi bi-bar-chart me-2"></i>12K</div>
                        </div>
                    </div>
                </div>
            </main>

            <!-- Right Sidebar Widgets -->
            <aside class="col-xl-4 d-none d-xl-block py-3 ps-4 pe-lg-5">
                <div class="position-sticky top-0 pt-1">
                    <!-- Search Bar -->
                    <div class="input-group mb-4 bg-light rounded-pill overflow-hidden border px-2 py-1">
                        <span class="input-group-text border-0 bg-transparent text-secondary"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-0 bg-transparent shadow-none" placeholder="Search">
                    </div>

                    <!-- Subscribe Widget -->
                    <div class="bg-light rounded-4 p-3 mb-4 border">
                        <h5 class="fw-bold mb-2">Subscribe to Premium</h5>
                        <p class="small text-secondary mb-3">Subscribe to unlock new features and if eligible, receive a share of ads revenue.</p>
                        <button class="btn btn-dark rounded-pill fw-bold px-4">Subscribe</button>
                    </div>

                    <!-- Who to Follow Widget -->
                    <div class="bg-light rounded-4 p-3 border">
                        <h5 class="fw-bold mb-3">Who to follow</h5>
                        
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center hover-bg p-1 rounded">
                                <img src="https://ui-avatars.com/api/?name=Jane+Smith&background=random" class="rounded-circle me-2" width="40" height="40">
                                <div class="lh-sm">
                                    <div class="fw-bold small">Jane Smith</div>
                                    <div class="text-secondary small">@janesmith</div>
                                </div>
                            </div>
                            <button class="btn btn-dark btn-sm rounded-pill fw-bold px-3 py-1">Follow</button>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center hover-bg p-1 rounded">
                                <img src="https://ui-avatars.com/api/?name=Dev+Community&background=random" class="rounded-circle me-2" width="40" height="40">
                                <div class="lh-sm">
                                    <div class="fw-bold small">Dev Community</div>
                                    <div class="text-secondary small">@ThePracticalDev</div>
                                </div>
                            </div>
                            <button class="btn btn-dark btn-sm rounded-pill fw-bold px-3 py-1">Follow</button>
                        </div>
                    </div>
                    
                    <!-- Footer Links -->
                    <div class="mt-4 text-secondary small px-3 d-flex flex-wrap gap-2">
                        <a href="#" class="text-decoration-none text-secondary hover-bg">Terms of Service</a>
                        <a href="#" class="text-decoration-none text-secondary hover-bg">Privacy Policy</a>
                        <a href="#" class="text-decoration-none text-secondary hover-bg">Cookie Policy</a>
                        <a href="#" class="text-decoration-none text-secondary hover-bg">Ads info</a>
                        <span>© 2026 X Clone</span>
                    </div>
                </div>
            </aside>
            
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
